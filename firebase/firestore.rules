rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isClubMember(clubId) {
      return isAuthenticated() && exists(
        /databases/$(database)/documents/clubMembers/$(request.auth.uid + '_' + clubId)
      );
    }

    function getUserRole(clubId) {
      let docPath = /databases/$(database)/documents/clubMembers/$(request.auth.uid + '_' + clubId);
      return exists(docPath) ? get(docPath).data.role : null;
    }

    function isOwnerOrAdmin(clubId) {
      let role = getUserRole(clubId);
      return role == 'OWNER' || role == 'ADMIN';
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Clubs
    match /clubs/{clubId} {
      allow read: if isAuthenticated() && isClubMember(clubId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwnerOrAdmin(clubId);
      allow delete: if false;
    }

    // Club members
    match /clubMembers/{memberId} {
      allow read: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isClubMember(resource.data.clubId));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.userId == request.auth.uid || isOwnerOrAdmin(resource.data.clubId));
      allow delete: if false;
    }
// Events
    match /events/{eventId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated() && isClubMember(request.resource.data.clubId);
      allow update: if isAuthenticated() && (isOwnerOrAdmin(resource.data.clubId) || getUserRole(resource.data.clubId) == 'EVENT_HEAD');
      allow delete: if isAuthenticated() && isOwnerOrAdmin(resource.data.clubId);
    }

    // Tasks
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwnerOrAdmin(resource.data.clubId) || resource.data.assignedTo == request.auth.uid);
      allow delete: if isAuthenticated() && isOwnerOrAdmin(resource.data.clubId);
    }

    // Volunteers
    match /volunteers/{volId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwnerOrAdmin(resource.data.clubId) || resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // Meetings
    match /meetings/{meetingId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow delete: if isAuthenticated() && isOwnerOrAdmin(resource.data.clubId);
    }

    // Meeting Action Items
    match /meetingActionItems/{itemId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow delete: if false;
    }

    // Documents
    match /documents/{docId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwnerOrAdmin(resource.data.clubId);
      allow delete: if isAuthenticated() && isOwnerOrAdmin(resource.data.clubId);
    }

    // Document Chunks
    match /documentChunks/{chunkId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if isAuthenticated() && isOwnerOrAdmin(resource.data.clubId);
    }

    // Risks
    match /risks/{riskId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow delete: if false;
    }

    // Announcements
    match /announcements/{annId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isOwnerOrAdmin(resource.data.clubId);
      allow delete: if isAuthenticated() && isOwnerOrAdmin(resource.data.clubId);
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }

    // AI Actions
    match /aiActions/{actionId} {
      allow read: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isClubMember(resource.data.clubId);
      allow delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}